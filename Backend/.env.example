;l# BLOCKEDLEARNING Backend Environment Variables

# ============ Server Configuration ============
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ============ Database ============
# For SQLite (default for development)
# No configuration needed - uses local file

# For PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/blockedlearning

# ============ Authentication ============
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============ AI Service ============
AI_SERVICE_URL=https://blockedlearning-production.up.railway.app

# ============ Blockchain Configuration ============
# RPC endpoint for the blockchain network (Camp Basecamp Testnet)
RPC_URL=https://rpc.basecamp.t.conduit.xyz
# Or use this alternate:
# CAMP_TESTNET_RPC=https://basecamp.camp/rpc

# Private key for signing transactions (DO NOT COMMIT!)
# Only needed if backend will send transactions directly
PRIVATE_KEY=

# Contract Addresses (Camp Basecamp Testnet - DEPLOYED)
IP_REGISTRY_ADDRESS=0x6D9bb552f5fa5f180Bb5C8c31ce877365088427D
COURSE_DIRECTORY_ADDRESS=0x34bfD3e362CC6f33d18cA55EBCA29a8946Bf3b9a
CERTIFICATE_NFT_ADDRESS=0xeA648db267C686269e687661BE24DFC96A338c77
REPUTATION_SYSTEM_ADDRESS=
ROYALTY_MANAGER_ADDRESS=

# ============ Optional ============
DEBUG=false
