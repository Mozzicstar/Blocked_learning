# BLOCKEDLEARNING Backend Environment Variables

# ============ Server Configuration ============
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ============ Database ============
# For SQLite (default for development)
# No configuration needed - uses local file

# For PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/blockedlearning

# ============ Authentication ============
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============ AI Service ============
AI_SERVICE_URL=https://blockedlearning-production.up.railway.app

# ============ Blockchain Configuration ============
# RPC endpoint for the blockchain network
RPC_URL=http://127.0.0.1:8545
# Or for Camp testnet:
# CAMP_TESTNET_RPC=https://basecamp.camp/rpc

# Private key for signing transactions (DO NOT COMMIT!)
# Only needed if backend will send transactions directly
PRIVATE_KEY=

# Contract Addresses (set after deployment)
IP_REGISTRY_ADDRESS=
COURSE_DIRECTORY_ADDRESS=
CERTIFICATE_NFT_ADDRESS=
REPUTATION_SYSTEM_ADDRESS=
ROYALTY_MANAGER_ADDRESS=

# ============ Optional ============
DEBUG=false
